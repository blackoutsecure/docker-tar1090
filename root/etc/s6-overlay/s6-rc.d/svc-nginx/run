#!/usr/bin/with-contenv bash

set -euo pipefail

# shellcheck disable=SC1091
source /usr/local/bin/log-functions.sh
SVC_NAME="nginx"

build_metadata_path=/usr/local/share/tar1090/build-metadata.env
if [[ -r "${build_metadata_path}" ]]; then
    set -a
    . "${build_metadata_path}"
    set +a
fi

tar1090_port=${TAR1090_PORT:-8080}
tar1090_source_dir=${TAR1090_SOURCE_DIR:-/data/readsb}

# Check source data directory
if [[ ! -d "${tar1090_source_dir}" ]]; then
    log_warn "source directory ${tar1090_source_dir} does not exist"
elif [[ ! -f "${tar1090_source_dir}/aircraft.json" ]]; then
    log_warn "aircraft.json not found in ${tar1090_source_dir} — no decoder data available"
else
    log_info "source data OK: ${tar1090_source_dir}/aircraft.json found"
fi

log_info "starting tar1090 nginx on port ${tar1090_port}"
log_info "web interface: http://<host-ip>:${tar1090_port}"

exec nginx -g 'daemon off;'
